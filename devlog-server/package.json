  "main": "index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "NODE_ENV=test node --test",
    "test:coverage": "NODE_ENV=test node --test --experimental-test-coverage",
    "docker:up": "docker compose -f ../docker-compose.yml up --build -d",
