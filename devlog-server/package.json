    "docker:down": "docker compose -f ../docker-compose.yml down --remove-orphans",
    "docker:test": "sh scripts/docker-test.sh",
    "docker:e2e": "sh scripts/docker-e2e.sh",
    "migrate:relations": "node scripts/migrateRelations.js"
  },
